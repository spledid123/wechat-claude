# WeChat Claude 密钥配置模板 —— 复制为 .env 并填入真实值。
# 读取优先级：系统环境变量 > exe 旁 .env > 数据目录 .wechat-claude\.env；
# 管理面板"设置"页保存的 API 配置（config.json）优先级最高。
# 三项均可留空按需填写：API Key 与 Auth Token 二选一即可（端点支持哪种填哪种）。

# Anthropic 兼容端点（DeepSeek 示例；留空则用官方 api.anthropic.com）
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# API Key（x-api-key 头）
ANTHROPIC_API_KEY=

# Auth Token（Bearer 头，与上面二选一）
ANTHROPIC_AUTH_TOKEN=
