{
  "name": "wechat-claude",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spledid123/wechat-claude.git"
  },
  "bugs": {
    "url": "https://github.com/spledid123/wechat-claude/issues"
  },
  "homepage": "https://github.com/spledid123/wechat-claude#readme",
  "scripts": {
    "setup": "powershell -ExecutionPolicy Bypass -File scripts/setup-deps.ps1",
    "setup:tauri": "powershell -ExecutionPolicy Bypass -File scripts/setup-tauri.ps1",
    "start": "tsx src/cli.ts",
    "build:app": "node scripts/clean-dist.mjs && tsc -p tsconfig.app.json && node scripts/copy-app-assets.js",
    "tauri:dev": "npm run build:app && tauri dev",
    "dist:portable": "node scripts/build-portable.mjs",
    "dist:src:zip": "powershell -ExecutionPolicy Bypass -File scripts/package-source-zip.ps1",
    "check-sdk": "node scripts/check-claude-sdk.js",
    "app:service": "tsx src/cli.ts",
    "uninstall": "powershell -ExecutionPolicy Bypass -File scripts/uninstall.ps1"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.0",
    "adm-zip": "^0.5.16",
    "qrcode": "^1.5.4",
    "sql.js": "^1.11.0",
    "tar-fs": "^3.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.0.0",
    "@types/sql.js": "^1.4.0",
    "@types/tar-fs": "^2.0.4",
    "tsx": "^4.22.4",
    "typescript": "^5.5.0"
  }
}
